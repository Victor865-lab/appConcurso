# Servidor
PORT=3000
# Em produção, defina NODE_ENV=production — isso ativa mensagens de erro
# genéricas (sem vazar stack trace) e outras otimizações do Express.
NODE_ENV=development
# "true" somente se a hospedagem colocar um proxy reverso confiável na
# frente da aplicação (Nginx, load balancer do provedor, etc.) — necessário
# para o rate limit e os logs enxergarem o IP real do cliente. Deixe "false"
# se a aplicação recebe conexões diretamente.
TRUST_PROXY=false
# Origens (domínios) autorizadas a chamar a API via CORS, separadas por
# vírgula. Em produção, use a URL pública real (ex: https://seusite.com.br).
# Se omitido, cai em APP_BASE_URL.
CORS_ORIGENS=

# SQL Server
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_PORT=1433
# Preencha DB_INSTANCE SOMENTE se seu SQL Server usa instância nomeada
# (comum em instalações locais/Express, ex: SQLEXPRESS). Nesse caso,
# DB_PORT é ignorado e a porta é resolvida automaticamente.
DB_INSTANCE=
DB_DATABASE=ConcursosDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Mercado Pago (assinaturas / Preapproval / Pix)
# Gere em https://www.mercadopago.com.br/developers/panel — comece com as
# credenciais de TESTE (Access Token de teste), depois troque para produção.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo usado para validar a assinatura (header x-signature) das notificações
# de webhook — fica no painel da sua aplicação em developers.mercadopago.com,
# em "Webhooks > Configurar notificações".
MERCADOPAGO_WEBHOOK_SECRET=
# URL base pública da aplicação, usada nos redirecionamentos de volta do
# Mercado Pago após o checkout e como destino do webhook (em produção, use
# a URL pública com HTTPS — o Mercado Pago não alcança http://localhost).
APP_BASE_URL=http://localhost:3000

# Trava de acesso: quando "true", bloqueia /progresso, /simulados, /ranking
# e /respostas para quem não tem assinatura ativa. Deixe "false" (ou omita)
# em ambiente de teste para liberar o acesso livremente.
EXIGIR_ASSINATURA=false

# E-mail (envio do link de "esqueci minha senha") — via Gmail SMTP.
# GMAIL_USER: o endereço Gmail que vai enviar os e-mails.
# GMAIL_APP_PASSWORD: NÃO é a senha normal da conta — gere uma "Senha de app"
# em myaccount.google.com/apppasswords (exige verificação em duas etapas
# ativada na conta Google).
GMAIL_USER=
GMAIL_APP_PASSWORD=
